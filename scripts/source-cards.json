    },
    {
      "id": "gage-40",
      "category": "GAGE",
      "number": 40,
      "text": "Fais applaudir trois joueurs sans leur demander d'applaudir.",
      "secret_mission": true
    },
    {
      "id": "gage-41",
      "category": "GAGE",
      "number": 41,
      "text": "Fais-toi donner un surnom sans le demander directement.",
      "secret_mission": true
    },
    {
      "id": "gage-42",
      "category": "GAGE",
      "number": 42,
      "text": "Pendant une minute, traite un objet comme ton meilleur ami.",
      "secret_mission": false
    },
    {
      "id": "gage-43",
      "category": "GAGE",
      "number": 43,
      "text": "Pendant une minute, réagis à tout comme à une révélation incroyable.",
      "secret_mission": false
    },
    {
      "id": "gage-44",
      "category": "GAGE",
      "number": 44,
      "text": "Donne un prénom à un objet et présente-le au groupe.",
      "secret_mission": false
    },
    {
      "id": "gage-45",
      "category": "GAGE",
      "number": 45,
      "text": "Pendant 30 secondes, fais semblant d'être invisible.",
      "secret_mission": false
    },
    {
      "id": "sonia-01",
      "category": "SONIA",
      "number": 1,
      "text": "Raconte ton premier souvenir avec Sonia.",
      "secret_mission": false
    },
    {
      "id": "sonia-02",
      "category": "SONIA",
      "number": 2,
      "text": "Raconte ton meilleur souvenir de soirée avec Sonia.",
      "secret_mission": false
    },
    {
      "id": "sonia-03",
      "category": "SONIA",
      "number": 3,
      "text": "Raconte une anecdote embarrassante sur Sonia.",
      "secret_mission": false
    },
    {
      "id": "sonia-04",
      "category": "SONIA",
      "number": 4,
      "text": "Quel est ton souvenir le plus drôle avec Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-05",
      "category": "SONIA",
      "number": 5,
      "text": "Raconte un moment où Sonia t'a surpris.",
      "secret_mission": false
    },
    {
      "id": "sonia-06",
      "category": "SONIA",
      "number": 6,
      "text": "Quelle est la pire idée que Sonia ait eue ?",
      "secret_mission": false
    },
    {
      "id": "sonia-07",
      "category": "SONIA",
      "number": 7,
      "text": "Raconte une fois où Sonia t'a fait rire aux larmes.",
      "secret_mission": false
    },
    {
      "id": "sonia-08",
      "category": "SONIA",
      "number": 8,
      "text": "Raconte une situation où Sonia t'a sauvé la mise.",
      "secret_mission": false
    },
    {
      "id": "sonia-09",
      "category": "SONIA",
      "number": 9,
      "text": "Quel est le plus gros défaut de Sonia, selon elle ?",
      "secret_mission": false
    },
    {
      "id": "sonia-10",
      "category": "SONIA",
      "number": 10,
      "text": "Quel est le plat préféré de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-11",
      "category": "SONIA",
      "number": 11,
      "text": "Quelle célébrité Sonia aimerait-elle rencontrer ?",
      "secret_mission": false
    },
    {
      "id": "sonia-12",
      "category": "SONIA",
      "number": 12,
      "text": "Quel est le film ou la série préféré de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-13",
      "category": "SONIA",
      "number": 13,
      "text": "Quel est le rêve de voyage de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-14",
      "category": "SONIA",
      "number": 14,
      "text": "Quelle est la plus grande peur de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-15",
      "category": "SONIA",
      "number": 15,
      "text": "Quel métier Sonia aurait-elle aimé exercer ?",
      "secret_mission": false
    },
    {
      "id": "sonia-16",
      "category": "SONIA",
      "number": 16,
      "text": "Quel est le plus grand plaisir coupable de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-17",
      "category": "SONIA",
      "number": 17,
      "text": "Quel surnom Sonia déteste-t-elle le plus ?",
      "secret_mission": false
    },
    {
      "id": "sonia-18",
      "category": "SONIA",
      "number": 18,
      "text": "Si Sonia était un animal, lequel serait-elle ?",
      "secret_mission": false
    },
    {
      "id": "sonia-19",
      "category": "SONIA",
      "number": 19,
      "text": "Quel superpouvoir irait le mieux à Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-20",
      "category": "SONIA",
      "number": 20,
      "text": "Quel titre donnerais-tu à la biographie de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-21",
      "category": "SONIA",
      "number": 21,
      "text": "Quel métier improbable Sonia pourrait-elle réussir ?",
      "secret_mission": false
    },
    {
      "id": "sonia-22",
      "category": "SONIA",
      "number": 22,
      "text": "Quelle émission de téléréalité Sonia pourrait-elle gagner ?",
      "secret_mission": false
    },
    {
      "id": "sonia-23",
      "category": "SONIA",
      "number": 23,
      "text": "Quel est le plus gros défaut de Sonia ?",
      "secret_mission": false
    },
    {
      "id": "sonia-24",
      "category": "SONIA",
      "number": 24,
      "text": "Quelle célébrité pourrait jouer Sonia dans un film ?",
      "secret_mission": false
    },
    {
      "id": "sonia-25",
      "category": "SONIA",
      "number": 25,
      "text": "Si Sonia devenait présidente, quelle serait sa première loi ?",
      "secret_mission": false
    },
    {
      "id": "sonia-26",
      "category": "SONIA",
      "number": 26,
      "text": "Fais un duel de grimaces avec Sonia. Le groupe vote.",
      "secret_mission": false
    },
    {
      "id": "sonia-27",
      "category": "SONIA",
      "number": 27,
      "text": "Imite Sonia. Elle doit deviner ce que tu caricatures.",
      "secret_mission": false
    },
    {
      "id": "sonia-28",
      "category": "SONIA",
      "number": 28,
      "text": "Fais deviner une chanson à Sonia en la fredonnant.",
      "secret_mission": false
    },
    {
      "id": "sonia-29",
      "category": "SONIA",
      "number": 29,
      "text": "Défie Sonia à un pierre-feuille-ciseaux en 3 manches.",
      "secret_mission": false
    },
    {
      "id": "sonia-30",
      "category": "SONIA",
      "number": 30,
      "text": "Défie Sonia au concours de regard. Le premier qui rit perd.",
      "secret_mission": false
    },
    {
      "id": "sonia-31",
      "category": "SONIA",
      "number": 31,
      "text": "Fais une publicité pour Sonia comme un produit révolutionnaire.",
      "secret_mission": false
    },
    {
      "id": "sonia-32",
      "category": "SONIA",
      "number": 32,
      "text": "Pose trois questions à Sonia. Elle répond en un mot à chacune.",
      "secret_mission": false
    },
    {
      "id": "sonia-33",
      "category": "SONIA",
      "number": 33,
      "text": "Sonia choisit un joueur qui avance d'une case.",
      "secret_mission": false
    },
    {
      "id": "sonia-34",
      "category": "SONIA",
      "number": 34,
      "text": "Sonia échange la place de deux joueurs sur le plateau.",
      "secret_mission": false
    },
    {
      "id": "sonia-35",
      "category": "SONIA",
      "number": 35,
      "text": "Sonia désigne un joueur qui rejoue immédiatement.",
      "secret_mission": false
    },
    {
      "id": "sonia-36",
      "category": "SONIA",
      "number": 36,
      "text": "Sonia choisit un joueur qui tire une carte Défi.",
      "secret_mission": false
    },
    {
      "id": "sonia-37",
      "category": "SONIA",
      "number": 37,
      "text": "Sonia désigne un joueur qui recule de deux cases.",
      "secret_mission": false
    },
    {
      "id": "sonia-38",
      "category": "SONIA",
      "number": 38,
      "text": "Sonia choisit un joueur qui avance de trois cases.",
      "secret_mission": false
    },
    {
      "id": "sonia-39",
      "category": "SONIA",
      "number": 39,
      "text": "Sonia peut annuler la prochaine sanction d'un joueur.",
      "secret_mission": false
    },
    {
      "id": "sonia-40",
      "category": "SONIA",
      "number": 40,
      "text": "Tous les joueurs changent de place autour de la table, sauf Sonia !",
      "secret_mission": false
    },
    {
      "id": "sonia-41",
      "category": "SONIA",
      "number": 41,
      "text": "Chacun dit un mot pour décrire Sonia, sans doublon.",
      "secret_mission": false
    },
    {
      "id": "sonia-42",
      "category": "SONIA",
      "number": 42,
      "text": "Le groupe invente un nouveau surnom pour Sonia.",
      "secret_mission": false
    },
    {
      "id": "sonia-43",
      "category": "SONIA",
      "number": 43,
      "text": "Chacun donne une qualité de Sonia, sans répétition.",
      "secret_mission": false
    },
    {
      "id": "sonia-44",
      "category": "SONIA",
      "number": 44,
      "text": "Chacun propose une chanson qui représente Sonia.",
      "secret_mission": false
    },
    {
      "id": "sonia-45",
      "category": "SONIA",
      "number": 45,
      "text": "Chacun prédit quelque chose d'amusant sur le futur de Sonia.",
      "secret_mission": false
    }
  ]
